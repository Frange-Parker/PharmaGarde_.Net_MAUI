<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="PharmaGarde.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:v="clr-namespace:PharmaGarde.Views"
       Shell.FlyoutBehavior="Disabled"
       Shell.NavBarIsVisible="False"
       Shell.TabBarIsVisible="False"
       Shell.BackgroundColor="{StaticResource Fond}">

    <!-- Chaque écran principal est une page racine : navigation par GoToAsync("//Route").
         La barre du bas est dessinée par notre contrôle BarreNav, pas par le Shell. -->
    <ShellContent Route="Splash" ContentTemplate="{DataTemplate v:SplashPage}" />
    <ShellContent Route="Accueil" ContentTemplate="{DataTemplate v:AccueilPage}" />
    <ShellContent Route="Liste" ContentTemplate="{DataTemplate v:ListePage}" />
    <ShellContent Route="Carte" ContentTemplate="{DataTemplate v:CartePage}" />
    <ShellContent Route="Reglages" ContentTemplate="{DataTemplate v:ReglagesPage}" />
    <ShellContent Route="Connexion" ContentTemplate="{DataTemplate v:ConnexionPage}" />
    <ShellContent Route="Inscription" ContentTemplate="{DataTemplate v:InscriptionPage}" />
    <ShellContent Route="Attente" ContentTemplate="{DataTemplate v:AttentePage}" />
    <ShellContent Route="Tableau" ContentTemplate="{DataTemplate v:TableauPage}" />
    <ShellContent Route="Planning" ContentTemplate="{DataTemplate v:PlanningPage}" />
    <ShellContent Route="MonOfficine" ContentTemplate="{DataTemplate v:MonOfficinePage}" />
    <ShellContent Route="Admin" ContentTemplate="{DataTemplate v:AdminPage}" />
</Shell>