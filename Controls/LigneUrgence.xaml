<?xml version="1.0" encoding="UTF-8" ?>
<ContentView x:Class="PharmaGarde.Controls.LigneUrgence"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Border Style="{StaticResource Card}" Padding="16,14">
        <!-- toucher = appeler -->
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnAppeler" />
        </Border.GestureRecognizers>
        <HorizontalStackLayout Spacing="12">
            <!-- pastille rouge -->
            <Ellipse WidthRequest="18" HeightRequest="18" Fill="{StaticResource Rouge}" VerticalOptions="Center" />
            <Label x:Name="LblNumero" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource Erreur}" />
            <Label x:Name="LblLibelle" FontAttributes="Bold" TextColor="{StaticResource TexteSec}" VerticalOptions="Center" />
        </HorizontalStackLayout>
    </Border>
</ContentView>