<?xml version="1.0" encoding="UTF-8" ?>
<ContentView x:Class="PharmaGarde.Controls.ChampChoix"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:h="clr-namespace:PharmaGarde.Helpers">
    <VerticalStackLayout Spacing="6">
        <!-- libellé au-dessus du champ -->
        <Label x:Name="LblLibelle" />
        <!-- cadre cliquable -->
        <Border x:Name="Cadre" Style="{StaticResource Field}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Label x:Name="LblIcone" Style="{StaticResource Icon}" TextColor="{StaticResource TexteSec}" />
                <Label x:Name="LblValeur" Grid.Column="1" VerticalOptions="Center" FontSize="15" />
                <Label Grid.Column="2" Text="{x:Static h:Icons.ExpandMore}" Style="{StaticResource Icon}" TextColor="{StaticResource TexteSec}" />
            </Grid>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnTape" />
            </Border.GestureRecognizers>
        </Border>
        <!-- message d'erreur -->
        <Label x:Name="LblMessage" FontSize="13" TextColor="{StaticResource Erreur}" IsVisible="False" />
    </VerticalStackLayout>
</ContentView>