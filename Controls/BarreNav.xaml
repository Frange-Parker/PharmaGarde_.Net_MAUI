<?xml version="1.0" encoding="UTF-8" ?>
<ContentView x:Class="PharmaGarde.Controls.BarreNav"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <!-- fond de la barre + fin trait de séparation en haut -->
    <Grid RowDefinitions="1,Auto" BackgroundColor="#1A1A1A">
        <BoxView Color="{StaticResource Bordure}" HeightRequest="1" />
        <!-- les onglets sont ajoutés ici par le code -->
        <Grid x:Name="Colonnes" Grid.Row="1" Padding="0,8,0,10" />
    </Grid>
</ContentView>