<?xml version="1.0" encoding="UTF-8" ?>
<ContentView x:Class="PharmaGarde.Controls.CartePharmacie"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:h="clr-namespace:PharmaGarde.Helpers"
             xmlns:c="clr-namespace:PharmaGarde.Controls">
    <Border Style="{StaticResource Card}">
        <!-- toucher la carte : ouvre la fiche -->
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnOuvrirDetail" />
        </Border.GestureRecognizers>
        <VerticalStackLayout Spacing="12">

            <!-- rubrique + badge de statut -->
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="{Binding Rubrique}" Style="{StaticResource Rubrique}" TextColor="{Binding CouleurRubrique}" VerticalOptions="Center" />
                <Border Grid.Column="1" Style="{StaticResource Badge}" BackgroundColor="{Binding BadgeFond}">
                    <Label Text="{Binding BadgeTexte}" Style="{StaticResource BadgeTexte}" TextColor="{Binding BadgeCouleur}" />
                </Border>
            </Grid>

            <!-- nom -->
            <Label Text="{Binding Nom}" Style="{StaticResource H2}" Margin="0,-6,0,0" />

            <!-- zone distance + information horaire -->
            <Border Style="{StaticResource Zone}" Padding="12,10">
                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*" ColumnSpacing="10">
                    <Label Text="{Binding IconeDistance}" Style="{StaticResource Icon}" FontSize="18" />
                    <HorizontalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                        <Label Text="{Binding DistanceValeur}" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource VertAccent}" />
                        <Label Text="{Binding DistanceUnite}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource VertAccent}"
                               VerticalOptions="End" Margin="0,0,0,3" />
                    </HorizontalStackLayout>
                    <BoxView Grid.Column="2" WidthRequest="1" HeightRequest="20" Color="{StaticResource Bordure}" />
                    <Label Grid.Column="3" Text="{Binding IconeInfo}" Style="{StaticResource Icon}" FontSize="16" TextColor="{StaticResource TexteSec}" />
                    <Label Grid.Column="4" Text="{Binding InfoHoraire}" TextColor="{Binding CouleurInfo}" VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- adresse -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Label Text="{x:Static h:Icons.Pin}" Style="{StaticResource Icon}" FontSize="16" TextColor="{StaticResource TexteSec}" VerticalOptions="Start" />
                <Label Grid.Column="1" Text="{Binding Adresse}" TextColor="{StaticResource TexteSec}" VerticalOptions="Center" />
            </Grid>

            <!-- note -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Label Text="{Binding IconeNote}" Style="{StaticResource Icon}" FontSize="16" TextColor="{StaticResource TexteSec}" VerticalOptions="Start" />
                <Label Grid.Column="1" Text="{Binding Note}" Style="{StaticResource Caption}" VerticalOptions="Center" />
            </Grid>

            <!-- première carte : deux boutons -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="{Binding EstPremiere}">
                <c:IconButton Text="Appeler" Icon="{x:Static h:Icons.Phone}" Variant="Secondary" Clicked="OnAppeler" />
                <c:IconButton Grid.Column="1" Text="Itinéraire" Icon="{x:Static h:Icons.NearMe}" IsEnabled="{Binding ItineraireActif}" Clicked="OnItineraire" />
            </Grid>

            <!-- autres cartes : barre "Détails & Appel direct" -->
            <Border IsVisible="{Binding EstAutre}" BackgroundColor="{StaticResource Surface}" StrokeShape="RoundRectangle 12"
                    Stroke="Transparent" Padding="14,0" HeightRequest="48">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Label Text="{x:Static h:Icons.Phone}" Style="{StaticResource Icon}" FontSize="18" />
                    <Label Grid.Column="1" Text="Détails &amp; Appel direct" FontAttributes="Bold" VerticalOptions="Center" />
                    <Label Grid.Column="2" Text="{x:Static h:Icons.ChevronRight}" Style="{StaticResource Icon}" TextColor="{StaticResource TexteSec}" />
                </Grid>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnOuvrirDetail" />
                </Border.GestureRecognizers>
            </Border>
        </VerticalStackLayout>
    </Border>
</ContentView>