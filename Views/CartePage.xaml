<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="PharmaGarde.Views.CartePage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:h="clr-namespace:PharmaGarde.Helpers"
             xmlns:c="clr-namespace:PharmaGarde.Controls">

    <!-- Grid EXTÉRIEUR : ligne 0 = toute la carte, ligne 1 = barre du bas -->
    <Grid RowDefinitions="*,Auto">

        <!-- Grid INTÉRIEUR : les 3 couches empilées dans la même cellule -->
        <Grid Grid.Row="0">

            <!-- COUCHE 1 : carte normale -->
            <Grid x:Name="Contenu">
                <!-- fond de carte vectoriel -->
                <AbsoluteLayout>
                    <!-- rues (simples traits) -->
                    <BoxView Color="#1C1C1C" HeightRequest="2" WidthRequest="700" Rotation="-8"
                             AbsoluteLayout.LayoutBounds="0.5,0.28,AutoSize,AutoSize" AbsoluteLayout.LayoutFlags="PositionProportional" />
                    <BoxView Color="#1C1C1C" HeightRequest="2" WidthRequest="700" Rotation="-14"
                             AbsoluteLayout.LayoutBounds="0.5,0.62,AutoSize,AutoSize" AbsoluteLayout.LayoutFlags="PositionProportional" />
                    <BoxView Color="#1C1C1C" HeightRequest="2" WidthRequest="900" Rotation="72"
                             AbsoluteLayout.LayoutBounds="0.3,0.4,AutoSize,AutoSize" AbsoluteLayout.LayoutFlags="PositionProportional" />
                    <BoxView Color="#1C1C1C" HeightRequest="2" WidthRequest="900" Rotation="-65"
                             AbsoluteLayout.LayoutBounds="0.75,0.4,AutoSize,AutoSize" AbsoluteLayout.LayoutFlags="PositionProportional" />

                    <!-- cercles de portée autour de l'utilisateur -->
                    <Border WidthRequest="320" HeightRequest="320" StrokeShape="Ellipse" Stroke="#1F3328" BackgroundColor="Transparent"
                            AbsoluteLayout.LayoutBounds="0.5,0.5,AutoSize,AutoSize" AbsoluteLayout.LayoutFlags="PositionProportional" />
                    <Border WidthRequest="200" HeightRequest="200" StrokeShape="Ellipse" Stroke="#1F3328" BackgroundColor="#131A16"
                            AbsoluteLayout.LayoutBounds="0.5,0.5,AutoSize,AutoSize" AbsoluteLayout.LayoutFlags="PositionProportional" />

                    <!-- utilisateur : point bleu + libellé -->
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center"
                                         AbsoluteLayout.LayoutBounds="0.5,0.5,AutoSize,AutoSize" AbsoluteLayout.LayoutFlags="PositionProportional">
                        <Border WidthRequest="26" HeightRequest="26" StrokeShape="Ellipse" BackgroundColor="#1E3A5F" Stroke="Transparent">
                            <Ellipse WidthRequest="14" HeightRequest="14" Fill="#4C8DFF" />
                        </Border>
                        <Border BackgroundColor="#0D0D0D" StrokeShape="RoundRectangle 10" Stroke="Transparent" Padding="8,3">
                            <Label Text="● Vous êtes ici" FontSize="11" TextColor="{StaticResource Bleu}" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- pin : Pharmacie de la Liberté -->
                    <VerticalStackLayout x:Name="PinLiberte" Spacing="3" HorizontalOptions="Center"
                                         AbsoluteLayout.LayoutBounds="0.15,0.2,AutoSize,AutoSize" AbsoluteLayout.LayoutFlags="PositionProportional">
                        <Border Style="{StaticResource Pin}">
                            <Label Text="{x:Static h:Icons.Add}" Style="{StaticResource Icon}" TextColor="Black" />
                        </Border>
                        <Border BackgroundColor="#0D0D0D" StrokeShape="RoundRectangle 10" Stroke="Transparent" Padding="8,3">
                            <Label Text="Pharmacie de la Liberté • 1,9 km" FontSize="11" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- pin : Pharmacie de Deïdo -->
                    <VerticalStackLayout x:Name="PinDeido" Spacing="3" HorizontalOptions="Center"
                                         AbsoluteLayout.LayoutBounds="0.95,0.3,AutoSize,AutoSize" AbsoluteLayout.LayoutFlags="PositionProportional">
                        <Border Style="{StaticResource Pin}" WidthRequest="28" HeightRequest="28">
                            <Label Text="{x:Static h:Icons.Add}" Style="{StaticResource Icon}" TextColor="Black" FontSize="16" />
                        </Border>
                        <Border BackgroundColor="#0D0D0D" StrokeShape="RoundRectangle 10" Stroke="Transparent" Padding="8,3">
                            <Label Text="Pharmacie de Deïdo • 2,8 km" FontSize="11" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- pin : Pharmacie des Cocotiers -->
                    <VerticalStackLayout x:Name="PinCocotiers" Spacing="3" HorizontalOptions="Center"
                                         AbsoluteLayout.LayoutBounds="0.3,0.7,AutoSize,AutoSize" AbsoluteLayout.LayoutFlags="PositionProportional">
                        <Border Style="{StaticResource Pin}" WidthRequest="28" HeightRequest="28">
                            <Label Text="{x:Static h:Icons.Add}" Style="{StaticResource Icon}" TextColor="Black" FontSize="16" />
                        </Border>
                        <Border BackgroundColor="#0D0D0D" StrokeShape="RoundRectangle 10" Stroke="Transparent" Padding="8,3">
                            <Label Text="Pharmacie des Cocotiers • 1,4 km" FontSize="11" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- pin sélectionné : Pharmacie du Centre + bulle -->
                    <VerticalStackLayout x:Name="PinCentre" Spacing="4" HorizontalOptions="Center"
                                         AbsoluteLayout.LayoutBounds="0.62,0.36,AutoSize,AutoSize" AbsoluteLayout.LayoutFlags="PositionProportional">
                        <Border BackgroundColor="#243030" Stroke="#3A4A4A" StrokeShape="RoundRectangle 10" Padding="10,6">
                            <VerticalStackLayout>
                                <Label Text="Pharmacie du Centre" FontAttributes="Bold" FontSize="12" />
                                <Label Text="650m" Style="{StaticResource Caption}" FontSize="11" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Style="{StaticResource Pin}" WidthRequest="42" HeightRequest="42">
                            <Label Text="{x:Static h:Icons.Add}" Style="{StaticResource Icon}" TextColor="Black" FontSize="26" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- boutons de la carte : me localiser, zoom + / - -->
                    <VerticalStackLayout Spacing="8"
                                         AbsoluteLayout.LayoutBounds="0.97,0.6,AutoSize,AutoSize" AbsoluteLayout.LayoutFlags="PositionProportional">
                        <Border Style="{StaticResource Rond}">
                            <Label Text="{x:Static h:Icons.MyLocation}" Style="{StaticResource Icon}" TextColor="{StaticResource Texte}" />
                        </Border>
                        <Border Style="{StaticResource Rond}" StrokeShape="RoundRectangle 12" HeightRequest="88" VerticalOptions="Start">
                            <VerticalStackLayout VerticalOptions="Center" Spacing="12">
                                <Label Text="{x:Static h:Icons.Add}" Style="{StaticResource Icon}" TextColor="{StaticResource Texte}" />
                                <Label Text="{x:Static h:Icons.Remove}" Style="{StaticResource Icon}" TextColor="{StaticResource Texte}" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </AbsoluteLayout>

                <!-- panneau du bas : détails de la pharmacie sélectionnée -->
                <Border VerticalOptions="End" BackgroundColor="{StaticResource Carte}" Stroke="Transparent"
                        StrokeShape="RoundRectangle 24,24,0,0" Padding="16,8,16,16">
                    <VerticalStackLayout Spacing="12">
                        <!-- poignée -->
                        <BoxView WidthRequest="40" HeightRequest="4" CornerRadius="2" Color="#444444" HorizontalOptions="Center" />
                        <!-- titre + badge -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Text="Pharmacie du Centre - Akwa" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
                            <Border Grid.Column="1" Style="{StaticResource Badge}">
                                <Label Text="● Garde 24h" Style="{StaticResource BadgeTexte}" />
                            </Border>
                        </Grid>
                        <!-- adresse -->
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="{x:Static h:Icons.Pin}" Style="{StaticResource Icon}" FontSize="16" TextColor="{StaticResource TexteSec}" />
                            <Label Text="Boulevard de la Liberté, Akwa - Douala" TextColor="{StaticResource TexteSec}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <!-- temps de trajet -->
                        <Border Style="{StaticResource Zone}" Padding="10">
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <HorizontalStackLayout Spacing="10">
                                    <Border BackgroundColor="#1E2A22" StrokeShape="RoundRectangle 8" Stroke="Transparent" WidthRequest="40" HeightRequest="40">
                                        <Label Text="{x:Static h:Icons.Car}" Style="{StaticResource Icon}" FontSize="18" />
                                    </Border>
                                    <VerticalStackLayout VerticalOptions="Center">
                                        <Label Text="En taxi / voiture" Style="{StaticResource Caption}" FontSize="11" />
                                        <Label FontSize="13">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="3 min" FontAttributes="Bold" />
                                                    <Span Text="(650m)" TextColor="{StaticResource TexteSec}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Grid.Column="1" Spacing="10">
                                    <Border BackgroundColor="#1E2630" StrokeShape="RoundRectangle 8" Stroke="Transparent" WidthRequest="40" HeightRequest="40">
                                        <Label Text="{x:Static h:Icons.Walk}" Style="{StaticResource Icon}" FontSize="18" TextColor="{StaticResource Bleu}" />
                                    </Border>
                                    <VerticalStackLayout VerticalOptions="Center">
                                        <Label Text="À pied" Style="{StaticResource Caption}" FontSize="11" />
                                        <Label FontSize="13">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="8 min" FontAttributes="Bold" />
                                                    <Span Text="(650m)" TextColor="{StaticResource TexteSec}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>
                        <!-- boutons : téléphone + itinéraire -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <c:IconButton Icon="{x:Static h:Icons.Phone}" Variant="Secondary" WidthRequest="52" Clicked="OnAppeler" />
                            <c:IconButton Grid.Column="1" Text="Itinéraire" Icon="{x:Static h:Icons.NearMe}" Clicked="OnItineraire" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- COUCHE 2 : état d'erreur de chargement de la carte -->
            <Grid x:Name="Erreur" IsVisible="False">
                <VerticalStackLayout VerticalOptions="Center" Spacing="18" Padding="24">
                    <Label Text="Impossible de charger la carte" FontSize="18" TextColor="{StaticResource TexteSec}" HorizontalOptions="Center" />
                    <Label Text="Vérifier votre connexion internet puis réessayer" FontSize="18"
                           TextColor="{StaticResource TexteSec}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
                <!-- panneau du bas vide -->
                <Border VerticalOptions="End" BackgroundColor="{StaticResource Carte}" Stroke="Transparent"
                        StrokeShape="RoundRectangle 24,24,0,0" Padding="16,8,16,36">
                    <VerticalStackLayout Spacing="22">
                        <BoxView WidthRequest="40" HeightRequest="4" CornerRadius="2" Color="#444444" HorizontalOptions="Center" />
                        <Label Text="Aucune donnée pour l'instant" Style="{StaticResource Caption}" FontSize="14" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- COUCHE 3 : barre du haut (bascule Liste / Carte + bouton filtres) -->
            <Grid ColumnDefinitions="Auto,*,Auto" Padding="16,16" VerticalOptions="Start">
                <Border BackgroundColor="{StaticResource Carte}" Stroke="{StaticResource Bordure}" StrokeShape="RoundRectangle 22" Padding="4">
                    <HorizontalStackLayout Spacing="4">
                        <Border BackgroundColor="Transparent" Stroke="Transparent" Padding="14,8">
                            <HorizontalStackLayout Spacing="6">
                                <Label Text="{x:Static h:Icons.List}" Style="{StaticResource Icon}" FontSize="16" TextColor="{StaticResource TexteSec}" />
                                <Label Text="Liste" TextColor="{StaticResource TexteSec}" />
                            </HorizontalStackLayout>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnVueListe" />
                            </Border.GestureRecognizers>
                        </Border>
                        <Border BackgroundColor="{StaticResource VertFond}" Stroke="Transparent" StrokeShape="RoundRectangle 18" Padding="14,8">
                            <HorizontalStackLayout Spacing="6">
                                <Label Text="{x:Static h:Icons.Map}" Style="{StaticResource Icon}" FontSize="16" />
                                <Label Text="Carte ●" FontAttributes="Bold" TextColor="{StaticResource VertAccent}" />
                            </HorizontalStackLayout>
                        </Border>
                    </HorizontalStackLayout>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Rond}">
                    <Label Text="{x:Static h:Icons.Tune}" Style="{StaticResource Icon}" TextColor="{StaticResource Texte}" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFiltres" />
                    </Border.GestureRecognizers>
                </Border>
            </Grid>
        </Grid>

        <!-- barre de navigation du bas -->
        <c:BarreNav Grid.Row="1" Actif="Carte" />

                <!-- couche des filtres : couvre toute la page, barre du bas comprise -->
        <c:PanneauFiltres x:Name="Panneau" Grid.Row="0" Grid.RowSpan="2" Appliquer="OnFiltresAppliques" />
    </Grid>
</ContentPage>