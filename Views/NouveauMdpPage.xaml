<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="PharmaGarde.Views.NouveauMdpPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:h="clr-namespace:PharmaGarde.Helpers"
             xmlns:c="clr-namespace:PharmaGarde.Controls"
             Shell.NavBarIsVisible="False"
             Shell.PresentationMode="NotAnimated">
    <ScrollView>
        <VerticalStackLayout Padding="24,16" Spacing="8">

            <!-- lien Retour -->
            <HorizontalStackLayout Spacing="4">
                <Label Text="{x:Static h:Icons.ChevronLeft}" Style="{StaticResource Icon}" />
                <Label Text="Retour" TextColor="{StaticResource VertAccent}" VerticalOptions="Center" />
                <HorizontalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnRetour" />
                </HorizontalStackLayout.GestureRecognizers>
            </HorizontalStackLayout>

            <!-- pictogramme -->
            <Border WidthRequest="88" HeightRequest="88" BackgroundColor="{StaticResource Carte}"
                    Stroke="{StaticResource Bordure}" StrokeShape="RoundRectangle 24"
                    HorizontalOptions="Center" Margin="0,32,0,16">
                <Label Text="{x:Static h:Icons.Key}" Style="{StaticResource Icon}" FontSize="44" />
            </Border>

            <!-- titre et explication -->
            <Label Text="Nouveau mot de passe" Style="{StaticResource H1}" HorizontalOptions="Center" />
            <Label Text="Choisissez un nouveau mot de passe d'au moins 8 caractères."
                   Style="{StaticResource Caption}" FontSize="14" HorizontalTextAlignment="Center" Margin="0,0,0,24" />

            <!-- nouveau mot de passe -->
            <Label Text="Nouveau mot de passe" />
            <Border x:Name="ChampMdp" Style="{StaticResource Field}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Label Text="{x:Static h:Icons.Lock}" Style="{StaticResource Icon}" TextColor="{StaticResource TexteSec}" />
                    <Entry x:Name="Mdp" Grid.Column="1" Placeholder="Minimum 8 caractères" IsPassword="True" TextChanged="OnTexteModifie" />
                </Grid>
            </Border>
            <Label x:Name="ErrMdp" Text="8 caractères minimum" IsVisible="False" TextColor="{StaticResource Erreur}" FontSize="13" />

            <!-- confirmation -->
            <Label Text="Confirmer le mot de passe" Margin="0,8,0,0" />
            <Border x:Name="ChampConfirm" Style="{StaticResource Field}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Label Text="{x:Static h:Icons.Lock}" Style="{StaticResource Icon}" TextColor="{StaticResource TexteSec}" />
                    <Entry x:Name="Confirm" Grid.Column="1" Placeholder="Retapez le mot de passe" IsPassword="True" TextChanged="OnTexteModifie" />
                </Grid>
            </Border>
            <Label x:Name="ErrConfirm" Text="Les mots de passe ne correspondent pas" IsVisible="False" TextColor="{StaticResource Erreur}" FontSize="13" />

            <!-- bouton -->
            <c:IconButton x:Name="BtnReinit" Text="Réinitialiser le mot de passe" Icon="{x:Static h:Icons.CheckCircle}"
                          Margin="0,16,0,0" Clicked="OnReinitialiser" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>