<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="PharmaGarde.Views.LegalPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:h="clr-namespace:PharmaGarde.Helpers"
             Shell.NavBarIsVisible="False"
             Shell.PresentationMode="NotAnimated">
    <ScrollView>
        <VerticalStackLayout Padding="16,16" Spacing="14">
            <!-- lien Retour -->
            <HorizontalStackLayout Spacing="4">
                <Label Text="{x:Static h:Icons.ChevronLeft}" Style="{StaticResource Icon}" />
                <Label Text="Retour" TextColor="{StaticResource VertAccent}" VerticalOptions="Center" />
                <HorizontalStackLayout.GestureRecognizers><TapGestureRecognizer Tapped="OnRetour" /></HorizontalStackLayout.GestureRecognizers>
            </HorizontalStackLayout>

            <Label Text="Informations légales" Style="{StaticResource H1}" FontSize="24" Margin="0,8,0,0" />

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Source des données" FontAttributes="Bold" FontSize="16" />
                    <Label Text="Les tours de garde proviennent de l'Ordre National des Pharmaciens du Cameroun (ONPC). Dans cette version de démonstration, les pharmacies affichées sont fictives."
                           Style="{StaticResource Caption}" FontSize="14" />
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Protection des données" FontAttributes="Bold" FontSize="16" />
                    <Label Text="La position GPS n'est utilisée que sur votre accord, pour afficher les pharmacies proches. Vos informations de profil restent sur votre téléphone."
                           Style="{StaticResource Caption}" FontSize="14" />
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Écoconception" FontAttributes="Bold" FontSize="16" />
                    <Label Text="Thème sombre, icônes vectorielles, aucune image, aucune animation superflue et mémorisation locale pour limiter les échanges réseau."
                           Style="{StaticResource Caption}" FontSize="14" />
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="À propos" FontAttributes="Bold" FontSize="16" />
                    <Label Text="PharmaGarde v2.4.0 • Projet réalisé dans un cadre pédagogique (ENSPD)." Style="{StaticResource Caption}" FontSize="14" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>