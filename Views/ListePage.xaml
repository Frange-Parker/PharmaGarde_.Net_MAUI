<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="PharmaGarde.Views.ListePage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:h="clr-namespace:PharmaGarde.Helpers"
             xmlns:c="clr-namespace:PharmaGarde.Controls"
             xmlns:m="clr-namespace:PharmaGarde.Models">

    <!-- 3 lignes : en-tête / contenu / barre du bas. Le panneau de filtres couvre tout (RowSpan) -->
    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ===== LIGNE 0 : EN-TÊTE ===== -->
        <VerticalStackLayout Grid.Row="0" Padding="16,16,16,8" Spacing="12">
            <VerticalStackLayout Spacing="2">
                <Label Text="Pharmacies de garde" Style="{StaticResource H2}" FontSize="24" />
                <Label x:Name="LblSousTitre" Text="Douala • 4 officines de garde ce soir" Style="{StaticResource Caption}" FontSize="14" />
            </VerticalStackLayout>

            <!-- bascule Vue Liste / Vue Carte -->
            <Border Style="{StaticResource Card}" Padding="4">
                <Grid ColumnDefinitions="*,*">
                    <Border BackgroundColor="{StaticResource Surface}" StrokeShape="RoundRectangle 12" Padding="10">
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                            <Label Text="{x:Static h:Icons.List}" Style="{StaticResource Icon}" FontSize="18" />
                            <Label Text="Vue Liste" FontAttributes="Bold" TextColor="{StaticResource VertAccent}" />
                        </HorizontalStackLayout>
                    </Border>
                    <Border Grid.Column="1" BackgroundColor="Transparent" Stroke="Transparent" Padding="10">
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                            <Label Text="{x:Static h:Icons.Map}" Style="{StaticResource Icon}" FontSize="18" TextColor="{StaticResource TexteSec}" />
                            <Label Text="Vue Carte" TextColor="{StaticResource TexteSec}" />
                        </HorizontalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnVueCarte" />
                        </Border.GestureRecognizers>
                    </Border>
                </Grid>
            </Border>

            <!-- puces : Tout / Ouvert maintenant / Filtrer ? -->
            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                <Border x:Name="ChipTout" BackgroundColor="{StaticResource Vert}" Stroke="Transparent" StrokeShape="RoundRectangle 16" Padding="14,8">
                    <Label x:Name="TxtTout" Text="Tout (4)" FontAttributes="Bold" TextColor="{StaticResource SurTexteVert}" />
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnChipTout" /></Border.GestureRecognizers>
                </Border>
                <Border x:Name="ChipOuvert" BackgroundColor="{StaticResource Surface}" Stroke="Transparent" StrokeShape="RoundRectangle 16" Padding="14,8">
                    <Label x:Name="TxtOuvert" Text="● Ouvert maintenant" />
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnChipOuvert" /></Border.GestureRecognizers>
                </Border>
                <Border BackgroundColor="{StaticResource Surface}" Stroke="Transparent" StrokeShape="RoundRectangle 16" Padding="14,8">
                    <Label Text="Filtrer ?" />
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnFiltrer" /></Border.GestureRecognizers>
                </Border>
            </HorizontalStackLayout>

            <!-- bandeau affiché en mode hors ligne -->
            <Border x:Name="BandeauHorsLigne" IsVisible="False" BackgroundColor="{StaticResource ErreurFond}"
                    Stroke="{StaticResource Erreur}" StrokeShape="RoundRectangle 12" Padding="12,8">
                <Label Text="● Mode hors ligne • Sauvegarde du 19/09/2026" FontSize="13"
                       TextColor="{StaticResource Erreur}" HorizontalOptions="Center" />
            </Border>
        </VerticalStackLayout>

        <!-- ===== LIGNE 1 : CONTENU ===== -->
        <ScrollView x:Name="Contenu" Grid.Row="1">
            <VerticalStackLayout Padding="16,4,16,16" Spacing="16">

                <!-- bandeau protocole de nuit -->
                <Border Style="{StaticResource Card}" Padding="12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border BackgroundColor="#16222B" StrokeShape="RoundRectangle 10" Stroke="Transparent" WidthRequest="44" HeightRequest="44">
                            <Label Text="{x:Static h:Icons.Moon}" Style="{StaticResource Icon}" TextColor="{StaticResource Bleu}" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="Protocole de nuit actif" FontAttributes="Bold" />
                            <Label Text="Munissez-vous de votre ordonnance si possible" Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- LES CARTES : une par pharmacie, créées à partir du modèle ci-dessous -->
                <VerticalStackLayout x:Name="ListeCartes" Spacing="16">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="m:Pharmacie">
                            <Border Style="{StaticResource Card}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnOuvrirDetail" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="12">

                                    <!-- rubrique + badge de statut -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding RubriqueAffichee}" Style="{StaticResource Rubrique}"
                                               TextColor="{Binding CouleurRubrique}" VerticalOptions="Center" />
                                        <Border Grid.Column="1" Style="{StaticResource Badge}"
                                                IsVisible="{Binding AffBadge}" BackgroundColor="{Binding BadgeFond}">
                                            <Label Text="{Binding BadgeTexte}" Style="{StaticResource BadgeTexte}"
                                                   TextColor="{Binding BadgeCouleur}" />
                                        </Border>
                                    </Grid>

                                    <!-- nom -->
                                    <Label Text="{Binding Nom}" Style="{StaticResource H2}" Margin="0,-6,0,0" />

                                    <!-- distance + information horaire -->
                                    <Border Style="{StaticResource Zone}" Padding="12,10">
                                        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*" ColumnSpacing="10">
                                            <Label Text="{Binding IconeDistance}" Style="{StaticResource Icon}" FontSize="18" />
                                            <HorizontalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                                <Label Text="{Binding DistanceValeur}" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource VertAccent}" />
                                                <Label Text="{Binding DistanceUnite}" FontSize="14" FontAttributes="Bold"
                                                       TextColor="{StaticResource VertAccent}" VerticalOptions="End" Margin="0,0,0,3" />
                                            </HorizontalStackLayout>
                                            <BoxView Grid.Column="2" WidthRequest="1" HeightRequest="20" Color="{StaticResource Bordure}" />
                                            <Label Grid.Column="3" Text="{Binding IconeInfo}" Style="{StaticResource Icon}" FontSize="16"
                                                   TextColor="{StaticResource TexteSec}" IsVisible="{Binding AIconeInfo}" />
                                            <Label Grid.Column="4" Text="{Binding InfoHoraire}" TextColor="{Binding CouleurInfo}" VerticalOptions="Center" />
                                        </Grid>
                                    </Border>

                                    <!-- adresse -->
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                        <Label Text="{x:Static h:Icons.Pin}" Style="{StaticResource Icon}" FontSize="16" TextColor="{StaticResource TexteSec}" VerticalOptions="Start" />
                                        <Label Grid.Column="1" Text="{Binding Adresse}" TextColor="{StaticResource TexteSec}" VerticalOptions="Center" />
                                    </Grid>

                                    <!-- note -->
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                        <Label Text="{Binding IconeNote}" Style="{StaticResource Icon}" FontSize="16" TextColor="{StaticResource TexteSec}" VerticalOptions="Start" />
                                        <Label Grid.Column="1" Text="{Binding Note}" Style="{StaticResource Caption}" VerticalOptions="Center" />
                                    </Grid>

                                    <!-- 1re carte (la plus proche) : deux boutons -->
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="{Binding EstPremiere}">
                                        <c:IconButton Text="Appeler" Icon="{x:Static h:Icons.Phone}" Variant="Secondary" Clicked="OnAppeler" />
                                        <c:IconButton Grid.Column="1" Text="Itinéraire" Icon="{x:Static h:Icons.NearMe}"
                                                      IsEnabled="{Binding ItineraireActif}" Clicked="OnItineraire" />
                                    </Grid>

                                    <!-- autres cartes : barre "Détails & Appel direct" -->
                                    <Border IsVisible="{Binding EstAutre}" BackgroundColor="{StaticResource Surface}"
                                            StrokeShape="RoundRectangle 12" Stroke="Transparent" Padding="14,0" HeightRequest="48">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                            <Label Text="{x:Static h:Icons.Phone}" Style="{StaticResource Icon}" FontSize="18" />
                                            <Label Grid.Column="1" Text="Détails &amp; Appel direct" FontAttributes="Bold" VerticalOptions="Center" />
                                            <Label Grid.Column="2" Text="{x:Static h:Icons.ChevronRight}" Style="{StaticResource Icon}" TextColor="{StaticResource TexteSec}" />
                                        </Grid>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnOuvrirDetail" />
                                        </Border.GestureRecognizers>
                                    </Border>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- ÉTAT VIDE : aucun résultat avec les filtres choisis -->
                <VerticalStackLayout x:Name="ZoneVide" IsVisible="False" Spacing="14" Padding="0,24,0,0">
                    <Border WidthRequest="88" HeightRequest="88" BackgroundColor="{StaticResource Carte}"
                            Stroke="{StaticResource Bordure}" StrokeShape="RoundRectangle 24" HorizontalOptions="Center">
                        <Label Text="{x:Static h:Icons.Search}" Style="{StaticResource Icon}" FontSize="44" />
                    </Border>
                    <Label Text="Aucune pharmacie de garde trouvée" Style="{StaticResource H2}" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                    <Label Text="Essayez d'élargir le rayon ou de changer de quartier." Style="{StaticResource Caption}" FontSize="14" HorizontalTextAlignment="Center" />
                    <c:IconButton Text="Réinitialiser les filtres" Icon="{x:Static h:Icons.Tune}" Variant="Secondary" Margin="0,8,0,0" Clicked="OnReinitialiser" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- ÉTAT D'ERREUR (prend la place du contenu) -->
        <VerticalStackLayout x:Name="Erreur" Grid.Row="1" IsVisible="False" VerticalOptions="Center" Spacing="18" Padding="24">
            <Label Text="Impossible de charger les gardes" FontSize="18" TextColor="{StaticResource TexteSec}" HorizontalOptions="Center" />
            <Label Text="Vérifier votre connexion internet puis réessayer" FontSize="18" TextColor="{StaticResource TexteSec}" HorizontalTextAlignment="Center" />
            <Label Text="Dernière sauvegarde: 19/09/2026" FontSize="16" HorizontalOptions="Center" Margin="0,24,0,0" />
            <Label Text="Utiliser les données hors ligne" FontSize="16" TextColor="{StaticResource VertAccent}" HorizontalOptions="Center">
                <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnDonneesHorsLigne" /></Label.GestureRecognizers>
            </Label>
        </VerticalStackLayout>

        <!-- ===== LIGNE 2 : barre du bas ===== -->
        <c:BarreNav Grid.Row="2" Actif="Liste" />

        <!-- ===== COUCHE DES FILTRES : dernier élément = au-dessus de tout ===== -->
        <c:PanneauFiltres x:Name="Panneau" Grid.Row="0" Grid.RowSpan="3" Appliquer="OnFiltresAppliques" />
    </Grid>
</ContentPage>