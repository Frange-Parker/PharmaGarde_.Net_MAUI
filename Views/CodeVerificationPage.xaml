<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="PharmaGarde.Views.CodeVerificationPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:h="clr-namespace:PharmaGarde.Helpers"
             xmlns:c="clr-namespace:PharmaGarde.Controls"
             Shell.NavBarIsVisible="False"
             Shell.PresentationMode="NotAnimated">
    <ScrollView>
        <VerticalStackLayout Padding="24,16" Spacing="8">

            <!-- lien Retour -->
            <HorizontalStackLayout Spacing="4">
                <Label Text="{x:Static h:Icons.ChevronLeft}" Style="{StaticResource Icon}" />
                <Label Text="Retour" TextColor="{StaticResource VertAccent}" VerticalOptions="Center" />
                <HorizontalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnRetour" />
                </HorizontalStackLayout.GestureRecognizers>
            </HorizontalStackLayout>

            <!-- pictogramme -->
            <Border WidthRequest="88" HeightRequest="88" BackgroundColor="{StaticResource Carte}"
                    Stroke="{StaticResource Bordure}" StrokeShape="RoundRectangle 24"
                    HorizontalOptions="Center" Margin="0,32,0,16">
                <Label Text="{x:Static h:Icons.MarkEmailRead}" Style="{StaticResource Icon}" FontSize="44" />
            </Border>

            <!-- titre et explication -->
            <Label Text="Vérification" Style="{StaticResource H1}" HorizontalOptions="Center" />
            <Label Text="Entrez le code à 6 chiffres envoyé à votre adresse e-mail."
                   Style="{StaticResource Caption}" FontSize="14" HorizontalTextAlignment="Center" Margin="0,0,0,24" />

            <!-- champ du code : grands chiffres espacés et centrés -->
            <Border x:Name="ChampCode" Style="{StaticResource Field}" HeightRequest="64">
                <Entry x:Name="Code" Placeholder="------" Keyboard="Numeric" MaxLength="6"
                       FontSize="28" FontAttributes="Bold" CharacterSpacing="8"
                       HorizontalTextAlignment="Center" TextChanged="OnTexteModifie" />
            </Border>

            <!-- message d'erreur -->
            <HorizontalStackLayout x:Name="ZoneErreur" IsVisible="False" Spacing="8">
                <Label Text="{x:Static h:Icons.Info}" Style="{StaticResource Icon}" FontSize="16" TextColor="{StaticResource Erreur}" />
                <Label Text="Code incorrect, veuillez réessayer" TextColor="{StaticResource Erreur}" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <!-- bouton de validation -->
            <c:IconButton x:Name="BtnValider" Text="Valider le code" Icon="{x:Static h:Icons.Check}"
                          Margin="0,12,0,0" Clicked="OnValider" />

            <!-- renvoyer le code -->
            <Label HorizontalOptions="Center" Margin="0,16,0,0">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Code non reçu ? " />
                        <Span Text="Renvoyer le code" TextColor="{StaticResource VertAccent}" FontAttributes="Bold" />
                    </FormattedString>
                </Label.FormattedText>
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnRenvoyer" />
                </Label.GestureRecognizers>
            </Label>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>