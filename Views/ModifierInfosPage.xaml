<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="PharmaGarde.Views.ModifierInfosPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:h="clr-namespace:PharmaGarde.Helpers"
             xmlns:c="clr-namespace:PharmaGarde.Controls"
             Shell.NavBarIsVisible="False"
             Shell.PresentationMode="NotAnimated">
    <ScrollView>
        <VerticalStackLayout Padding="16,16" Spacing="8">

            <!-- lien Retour -->
            <HorizontalStackLayout Spacing="4">
                <Label Text="{x:Static h:Icons.ChevronLeft}" Style="{StaticResource Icon}" />
                <Label Text="Retour" TextColor="{StaticResource VertAccent}" VerticalOptions="Center" />
                <HorizontalStackLayout.GestureRecognizers><TapGestureRecognizer Tapped="OnRetour" /></HorizontalStackLayout.GestureRecognizers>
            </HorizontalStackLayout>

            <Label Text="Modifier mes informations" Style="{StaticResource H1}" FontSize="24" Margin="0,16,0,16" />

            <!-- nom -->
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Nom complet" />
                <Label x:Name="ErrNom" Grid.Column="1" Text="Obligatoire" IsVisible="False" TextColor="{StaticResource Erreur}" />
            </Grid>
            <Border x:Name="ChampNom" Style="{StaticResource Field}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Label Text="{x:Static h:Icons.PersonOutline}" Style="{StaticResource Icon}" TextColor="{StaticResource TexteSec}" />
                    <Entry x:Name="Nom" Grid.Column="1" TextChanged="OnTexteModifie" />
                </Grid>
            </Border>

            <!-- e-mail -->
            <Label Text="Adresse e-mail" Margin="0,8,0,0" />
            <Border Style="{StaticResource Field}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Label Text="{x:Static h:Icons.Mail}" Style="{StaticResource Icon}" TextColor="{StaticResource TexteSec}" />
                    <Entry x:Name="Email" Grid.Column="1" Keyboard="Email" />
                </Grid>
            </Border>

            <!-- téléphone -->
            <Label Text="Téléphone" Margin="0,8,0,0" />
            <Border Style="{StaticResource Field}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Label Text="{x:Static h:Icons.Phone}" Style="{StaticResource Icon}" TextColor="{StaticResource TexteSec}" />
                    <Entry x:Name="Tel" Grid.Column="1" Keyboard="Telephone" />
                </Grid>
            </Border>

            <!-- ville (boîte de sélection native) -->
            <Label Text="Ville de couverture" Margin="0,8,0,0" />
            <Border Style="{StaticResource Field}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Label Text="{x:Static h:Icons.City}" Style="{StaticResource Icon}" TextColor="{StaticResource TexteSec}" />
                    <Label x:Name="TxtVille" Grid.Column="1" Text="Douala" VerticalOptions="Center" />
                    <Label Grid.Column="2" Text="{x:Static h:Icons.ExpandMore}" Style="{StaticResource Icon}" TextColor="{StaticResource TexteSec}" />
                </Grid>
                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnChoisirVille" /></Border.GestureRecognizers>
            </Border>

            <!-- quartier -->
            <Label Text="Quartier habituel" Margin="0,8,0,0" />
            <Border Style="{StaticResource Field}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Label Text="{x:Static h:Icons.Explore}" Style="{StaticResource Icon}" TextColor="{StaticResource TexteSec}" />
                    <Label x:Name="TxtQuartier" Grid.Column="1" Text="Akwa" VerticalOptions="Center" />
                    <Label Grid.Column="2" Text="{x:Static h:Icons.ExpandMore}" Style="{StaticResource Icon}" TextColor="{StaticResource TexteSec}" />
                </Grid>
                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnChoisirQuartier" /></Border.GestureRecognizers>
            </Border>

            <c:IconButton Text="Enregistrer" Icon="{x:Static h:Icons.Check}" Margin="0,20,0,0" Clicked="OnEnregistrer" />
            <c:IconButton Text="Annuler" Variant="Secondary" Margin="0,4,0,0" Clicked="OnAnnuler" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>