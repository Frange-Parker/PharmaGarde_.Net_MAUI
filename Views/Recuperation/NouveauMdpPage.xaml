<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="PharmaGarde.Views.NouveauMdpPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:h="clr-namespace:PharmaGarde.Helpers"
             xmlns:c="clr-namespace:PharmaGarde.Controls"
             Shell.NavBarIsVisible="False"
             Shell.PresentationMode="NotAnimated">
    <ScrollView>
        <VerticalStackLayout Padding="24,16" Spacing="10">
            <HorizontalStackLayout Spacing="4">
                <Label Text="{x:Static h:Icons.ChevronLeft}" Style="{StaticResource Icon}" />
                <Label Text="Retour" TextColor="{StaticResource VertAccent}" VerticalOptions="Center" />
                <HorizontalStackLayout.GestureRecognizers><TapGestureRecognizer Tapped="OnRetour" /></HorizontalStackLayout.GestureRecognizers>
            </HorizontalStackLayout>

            <Border WidthRequest="88" HeightRequest="88" BackgroundColor="{StaticResource Carte}" Stroke="{StaticResource Bordure}"
                    StrokeShape="RoundRectangle 24" HorizontalOptions="Center" Margin="0,32,0,16">
                <Label Text="{x:Static h:Icons.Key}" Style="{StaticResource Icon}" FontSize="44" />
            </Border>
            <Label Text="Nouveau mot de passe" Style="{StaticResource H1}" HorizontalOptions="Center" />
            <Label Text="Choisissez un nouveau mot de passe d'au moins 8 caractères."
                   Style="{StaticResource Caption}" FontSize="14" HorizontalTextAlignment="Center" Margin="0,0,0,20" />

            <c:ChampSaisie x:Name="Mdp" Libelle="Nouveau mot de passe" Icone="{x:Static h:Icons.Lock}" Placeholder="Minimum 8 caractères"
                           EstMotDePasse="True" TexteModifie="OnChange" />
            <c:ChampSaisie x:Name="Confirm" Libelle="Confirmer le mot de passe" Icone="{x:Static h:Icons.Lock}" Placeholder="Retapez le mot de passe"
                           EstMotDePasse="True" TexteModifie="OnChange" />

            <c:IconButton x:Name="BtnReinit" Text="Réinitialiser le mot de passe" Icon="{x:Static h:Icons.CheckCircle}" Margin="0,12,0,0" Clicked="OnReinitialiser" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>