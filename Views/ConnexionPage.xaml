<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="PharmaGarde.Views.ConnexionPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:h="clr-namespace:PharmaGarde.Helpers"
             xmlns:c="clr-namespace:PharmaGarde.Controls">
    <ScrollView>
        <VerticalStackLayout Padding="24,0" VerticalOptions="Center" Spacing="8">
            <!-- titre et sous-titre -->
            <Label Text="Connexion" Style="{StaticResource H1}" HorizontalOptions="Center" />
            <Label Text="Accédez à vos officines de garde les plus proches en temps réel."
                   Style="{StaticResource Caption}" FontSize="14" HorizontalTextAlignment="Center"
                   Margin="0,0,0,24" />

            <!-- champ e-mail -->
            <Label Text="Adresse email" />
            <Border x:Name="ChampEmail" Style="{StaticResource Field}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Label Text="{x:Static h:Icons.Mail}" Style="{StaticResource Icon}"
                           TextColor="{StaticResource TexteSec}" />
                    <Entry x:Name="Email" Grid.Column="1" Text="nom@exemple.fr" Keyboard="Email"
                           TextChanged="OnTexteModifie" />
                </Grid>
            </Border>

            <!-- ligne "Mot de passe" + lien "oublié" -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                <Label Text="Mot de passe" />
                <Label Grid.Column="1" Text="Mot de passe oublié ?" FontSize="12" TextColor="{StaticResource VertAccent}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnMdpOublie" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>
            <!-- champ mot de passe avec bouton "œil" -->
            <Border x:Name="ChampMdp" Style="{StaticResource Field}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Label Text="{x:Static h:Icons.Lock}" Style="{StaticResource Icon}"
                           TextColor="{StaticResource TexteSec}" />
                    <Entry x:Name="Mdp" Grid.Column="1" Text="motdepasse123" IsPassword="True"
                           TextChanged="OnTexteModifie" />
                    <Label x:Name="IconeOeil" Grid.Column="2" Text="{x:Static h:Icons.EyeOff}"
                           Style="{StaticResource Icon}" TextColor="{StaticResource TexteSec}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnOeil" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>
            </Border>

            <!-- message d'erreur (caché par défaut) -->
            <HorizontalStackLayout x:Name="ZoneErreur" IsVisible="False" Spacing="8">
                <Label Text="{x:Static h:Icons.Info}" Style="{StaticResource Icon}" FontSize="16"
                       TextColor="{StaticResource Erreur}" />
                <Label Text="Adresse e-mail ou mot de passe invalide" TextColor="{StaticResource Erreur}"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>

            <!-- bouton principal -->
            <c:IconButton x:Name="BtnConnexion" Text="Se connecter" Icon="{x:Static h:Icons.Login}"
                          Margin="0,12,0,0" Clicked="OnConnecter" />

            <!-- séparateur "OU" -->
            <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="12" Margin="0,12">
                <BoxView HeightRequest="1" Color="{StaticResource Bordure}" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="OU" Style="{StaticResource Caption}" />
                <BoxView Grid.Column="2" HeightRequest="1" Color="{StaticResource Bordure}"
                         VerticalOptions="Center" />
            </Grid>

            <!-- bouton mode invité -->
            <Border BackgroundColor="{StaticResource Carte}" Stroke="{StaticResource Bordure}"
                    StrokeShape="RoundRectangle 12" Padding="12" HeightRequest="60">
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="14">
                    <Label Text="{x:Static h:Icons.Shield}" Style="{StaticResource Icon}" />
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label Text="Continuer en mode Invité" />
                        <Label Text="(Accès Urgence immédiat)" FontSize="11"
                               TextColor="{StaticResource VertAccent}" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnInvite" />
                </Border.GestureRecognizers>
            </Border>

            <!-- lien vers l'inscription -->
            <Label HorizontalOptions="Center" Margin="0,16,0,0">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Pas encore de compte ? " />
                        <Span Text="Créer un compte" TextColor="{StaticResource VertAccent}"
                              FontAttributes="Bold" />
                    </FormattedString>
                </Label.FormattedText>
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCreerCompte" />
                </Label.GestureRecognizers>
            </Label>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>