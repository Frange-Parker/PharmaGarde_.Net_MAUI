<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="PharmaGarde.Views.TableauPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:h="clr-namespace:PharmaGarde.Helpers"
             xmlns:c="clr-namespace:PharmaGarde.Controls">
    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="16" Spacing="14">

                <!-- salutation + badge de validation -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <VerticalStackLayout Spacing="2">
                        <Label x:Name="LblBonjour" Style="{StaticResource H2}" FontSize="24" />
                        <Label x:Name="LblOfficine" Style="{StaticResource Caption}" FontSize="14" />
                    </VerticalStackLayout>
                    <Border Grid.Column="1" Style="{StaticResource Badge}" VerticalOptions="Start">
                        <Label Text="● Compte validé" Style="{StaticResource BadgeTexte}" />
                    </Border>
                </Grid>

                <!-- alerte : aucune permanence prévue -->
                <Border x:Name="Alerte" IsVisible="False" BackgroundColor="#3D2F10" Stroke="{StaticResource Ambre}" StrokeShape="RoundRectangle 12" Padding="14">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Label Text="{x:Static h:Icons.Warning}" Style="{StaticResource Icon}" TextColor="{StaticResource Ambre}" VerticalOptions="Start" />
                        <Label Grid.Column="1" Text="Aucune permanence prévue dans les 7 jours. Déclarez-en une pour que les patients vous trouvent."
                               TextColor="{StaticResource Ambre}" />
                    </Grid>
                </Border>

                <!-- statut actuel -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="STATUT ACTUEL" Style="{StaticResource Rubrique}" />
                        <Label x:Name="LblStatut" FontSize="20" FontAttributes="Bold" />
                        <Label x:Name="LblStatutDetail" Style="{StaticResource Caption}" FontSize="13" />
                    </VerticalStackLayout>
                </Border>

                <!-- prochaine permanence -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="PROCHAINE PERMANENCE" Style="{StaticResource Rubrique}" />
                        <Label x:Name="LblProchaine" FontSize="16" FontAttributes="Bold" />
                        <Label x:Name="LblProchaineDetail" Style="{StaticResource Caption}" FontSize="13" />
                    </VerticalStackLayout>
                </Border>

                <c:IconButton x:Name="BtnDeclarer" Text="Déclarer une permanence" Icon="{x:Static h:Icons.AddCircle}" HeightRequest="52" Clicked="OnDeclarer" />
                <Label x:Name="LblHorsLigne" Text="Hors ligne : la déclaration de permanence est indisponible." TextColor="{StaticResource Erreur}"
                       FontSize="13" HorizontalOptions="Center" IsVisible="False" />

                <Label x:Name="LblMaj" Style="{StaticResource Caption}" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </ScrollView>

        <c:BarreNav Grid.Row="1" Mode="Pharmacien" Actif="Tableau" />
    </Grid>
</ContentPage>