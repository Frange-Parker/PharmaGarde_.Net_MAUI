<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="PharmaGarde.Views.InscriptionPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:h="clr-namespace:PharmaGarde.Helpers"
             xmlns:c="clr-namespace:PharmaGarde.Controls">
    <ScrollView>
        <VerticalStackLayout Padding="16,24" Spacing="8">
            <!-- en-tête -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                <Ellipse WidthRequest="8" HeightRequest="8" Fill="{StaticResource Vert}" VerticalOptions="Center" />
                <Label Text="ACCÈS RAPIDE &amp; SECOURS" FontSize="12" FontAttributes="Bold"
                       TextColor="{StaticResource VertAccent}" CharacterSpacing="1" />
            </HorizontalStackLayout>
            <Label Text="Inscription" Style="{StaticResource H1}" HorizontalOptions="Center" />
            <Label Text="Créez un compte pour mémoriser votre secteur géographique de garde"
                   Style="{StaticResource Caption}" FontSize="14" HorizontalTextAlignment="Center"
                   Margin="0,0,0,12" />

            <!-- Nom complet -->
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Nom complet" />
                <Label x:Name="ErrNom" Grid.Column="1" Text="Obligatoire" IsVisible="False"
                       TextColor="{StaticResource Erreur}" />
            </Grid>
            <Border x:Name="ChampNom" Style="{StaticResource Field}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Label Text="{x:Static h:Icons.PersonOutline}" Style="{StaticResource Icon}"
                           TextColor="{StaticResource TexteSec}" />
                    <Entry x:Name="Nom" Grid.Column="1" Placeholder="Ex: Dr. Samuel Eto'o ou Jean Mballa"
                           TextChanged="OnTexteModifie" />
                </Grid>
            </Border>

            <!-- E-mail -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                <Label Text="Adresse e-mail" />
                <Label x:Name="ErrEmail" Grid.Column="1" Text="Invalide" IsVisible="False"
                       TextColor="{StaticResource Erreur}" />
            </Grid>
            <Border x:Name="ChampEmail" Style="{StaticResource Field}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Label Text="{x:Static h:Icons.Mail}" Style="{StaticResource Icon}"
                           TextColor="{StaticResource TexteSec}" />
                    <Entry x:Name="Email" Grid.Column="1" Placeholder="votre.contact@exemple.fr"
                           Keyboard="Email" TextChanged="OnTexteModifie" />
                </Grid>
            </Border>

            <!-- Mot de passe + lien Afficher/Masquer -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                <Label Text="Mot de passe" />
                <HorizontalStackLayout Grid.Column="1" Spacing="6">
                    <Label x:Name="IconeOeil" Text="{x:Static h:Icons.Eye}" Style="{StaticResource Icon}"
                           FontSize="16" />
                    <Label x:Name="TexteOeil" Text="Afficher" FontAttributes="Bold"
                           TextColor="{StaticResource VertAccent}" />
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnOeil" />
                    </HorizontalStackLayout.GestureRecognizers>
                </HorizontalStackLayout>
            </Grid>
            <Border x:Name="ChampMdp" Style="{StaticResource Field}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Label Text="{x:Static h:Icons.Lock}" Style="{StaticResource Icon}"
                           TextColor="{StaticResource TexteSec}" />
                    <Entry x:Name="Mdp" Grid.Column="1" Placeholder="Minimum 8 caractères"
                           IsPassword="True" TextChanged="OnTexteModifie" />
                </Grid>
            </Border>
            <Label x:Name="AideMdp" Text="8+ caractères recommandés" Style="{StaticResource Caption}"
                   HorizontalOptions="End" />
            

                        <!-- Ville : boîte de sélection native au toucher -->
            <Label Text="Ville de référence" Margin="0,8,0,0" />
            <Border Style="{StaticResource Field}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Label Text="{x:Static h:Icons.City}" Style="{StaticResource Icon}" TextColor="{StaticResource TexteSec}" />
                    <Label x:Name="TxtVille" Grid.Column="1" Text="Douala" VerticalOptions="Center" />
                    <Label Grid.Column="2" Text="{x:Static h:Icons.ExpandMore}" Style="{StaticResource Icon}" TextColor="{StaticResource TexteSec}" />
                </Grid>
                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnChoisirVille" /></Border.GestureRecognizers>
            </Border>

            <!-- Quartier -->
            <Label Text="Arrondissement / Quartier" Margin="0,8,0,0" />
            <Border Style="{StaticResource Field}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Label Text="{x:Static h:Icons.Explore}" Style="{StaticResource Icon}" TextColor="{StaticResource TexteSec}" />
                    <Label x:Name="TxtQuartier" Grid.Column="1" Text="Akwa / Bonanjo" VerticalOptions="Center" />
                    <Label Grid.Column="2" Text="{x:Static h:Icons.ExpandMore}" Style="{StaticResource Icon}" TextColor="{StaticResource TexteSec}" />
                </Grid>
                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnChoisirQuartier" /></Border.GestureRecognizers>
            </Border>
                   
            <!-- bouton d'inscription -->
            <c:IconButton x:Name="BtnInscrire" Text="S'inscrire" Icon="{x:Static h:Icons.PersonAdd}"
                          Margin="0,16,0,0" Clicked="OnInscrire" />

            <!-- lien vers la connexion -->
            <Label HorizontalOptions="Center" Margin="0,8,0,0">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Déjà inscrit ? " />
                        <Span Text="Se connecter" TextColor="{StaticResource VertAccent}" FontAttributes="Bold" />
                    </FormattedString>
                </Label.FormattedText>
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSeConnecter" />
                </Label.GestureRecognizers>
            </Label>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>