<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="PharmaGarde.Views.MotDePasseOubliePage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:h="clr-namespace:PharmaGarde.Helpers"
             xmlns:c="clr-namespace:PharmaGarde.Controls"
             Shell.NavBarIsVisible="False"
             Shell.PresentationMode="NotAnimated">
    <ScrollView>
        <VerticalStackLayout Padding="24,16" Spacing="8">

            <!-- lien Retour en haut à gauche -->
            <HorizontalStackLayout Spacing="4">
                <Label Text="{x:Static h:Icons.ChevronLeft}" Style="{StaticResource Icon}" />
                <Label Text="Retour" TextColor="{StaticResource VertAccent}" VerticalOptions="Center" />
                <HorizontalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnRetour" />
                </HorizontalStackLayout.GestureRecognizers>
            </HorizontalStackLayout>

            <!-- pictogramme dans un carré arrondi -->
            <Border WidthRequest="88" HeightRequest="88" BackgroundColor="{StaticResource Carte}"
                    Stroke="{StaticResource Bordure}" StrokeShape="RoundRectangle 24"
                    HorizontalOptions="Center" Margin="0,32,0,16">
                <Label Text="{x:Static h:Icons.LockReset}" Style="{StaticResource Icon}" FontSize="44" />
            </Border>

            <!-- titre et explication -->
            <Label Text="Mot de passe oublié" Style="{StaticResource H1}" HorizontalOptions="Center" />
            <Label Text="Saisissez l'adresse e-mail de votre compte. Nous vous enverrons un code de vérification."
                   Style="{StaticResource Caption}" FontSize="14" HorizontalTextAlignment="Center" Margin="0,0,0,24" />

            <!-- champ e-mail -->
            <Label Text="Adresse email" />
            <Border x:Name="ChampEmail" Style="{StaticResource Field}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Label Text="{x:Static h:Icons.Mail}" Style="{StaticResource Icon}" TextColor="{StaticResource TexteSec}" />
                    <Entry x:Name="Email" Grid.Column="1" Placeholder="nom@exemple.fr" Keyboard="Email" TextChanged="OnTexteModifie" />
                </Grid>
            </Border>

            <!-- message d'erreur (caché par défaut) -->
            <HorizontalStackLayout x:Name="ZoneErreur" IsVisible="False" Spacing="8">
                <Label Text="{x:Static h:Icons.Info}" Style="{StaticResource Icon}" FontSize="16" TextColor="{StaticResource Erreur}" />
                <Label Text="Adresse e-mail invalide" TextColor="{StaticResource Erreur}" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <!-- bouton d'envoi -->
            <c:IconButton x:Name="BtnEnvoyer" Text="Envoyer le code" Icon="{x:Static h:Icons.MarkEmailRead}"
                          Margin="0,12,0,0" Clicked="OnEnvoyer" />

            <!-- lien vers la connexion -->
            <Label Text="Retour à la connexion" TextColor="{StaticResource VertAccent}" FontAttributes="Bold"
                   HorizontalOptions="Center" Margin="0,16,0,0">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnRetour" />
                </Label.GestureRecognizers>
            </Label>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>