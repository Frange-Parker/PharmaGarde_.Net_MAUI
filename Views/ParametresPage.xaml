<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="PharmaGarde.Views.ParametresPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:h="clr-namespace:PharmaGarde.Helpers"
             xmlns:c="clr-namespace:PharmaGarde.Controls"
             Shell.NavBarIsVisible="False"
             Shell.PresentationMode="NotAnimated">
    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="16,16" Spacing="12">

                <Label Text="Paramètres" Style="{StaticResource H2}" FontSize="24" Margin="4,0,0,4" />

                <!-- PRÉFÉRENCES GÉOGRAPHIQUES -->
                <Label Text="PRÉFÉRENCES GÉOGRAPHIQUES" Style="{StaticResource Rubrique}" Margin="4,0,0,0" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Zone favorite par défaut" Style="{StaticResource Caption}" FontSize="13" />
                        <!-- boîte de sélection native au toucher -->
                        <Border Style="{StaticResource Field}" BackgroundColor="{StaticResource Zone}" Stroke="{StaticResource Bordure}" HeightRequest="48">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label x:Name="TxtZone" Text="Douala 1er - Akwa / Bonanjo" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{x:Static h:Icons.ExpandMore}" Style="{StaticResource Icon}" TextColor="{StaticResource TexteSec}" />
                            </Grid>
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnChoisirZone" /></Border.GestureRecognizers>
                        </Border>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Localisation GPS" VerticalOptions="Center" />
                            <Switch x:Name="SwGps" Grid.Column="1" Toggled="OnBasculeOption" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- SOBRIÉTÉ & PERFORMANCE + badge dynamique -->
                <Grid ColumnDefinitions="*,Auto" Margin="4,8,0,0">
                    <Label Text="SOBRIÉTÉ &amp; PERFORMANCE" Style="{StaticResource Rubrique}" VerticalOptions="Center" />
                    <Border x:Name="BadgeEco" Grid.Column="1" Style="{StaticResource Badge}">
                        <Label x:Name="TxtEco" Text="Eco-actif" Style="{StaticResource BadgeTexte}" />
                    </Border>
                </Grid>
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Mode sombre OLED strict" FontAttributes="Bold" FontSize="15" />
                                <Label Text="Zéro émission de pixel lumineux" Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                            <Switch x:Name="SwOled" Grid.Column="1" Toggled="OnBasculeOption" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Mémorisation hors-ligne des gardes" FontAttributes="Bold" FontSize="15" />
                                <Label Text="Disponibilité sans réseau mobile" Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                            <Switch x:Name="SwHorsLigne" Grid.Column="1" Toggled="OnBasculeOption" />
                        </Grid>
                        <Border Style="{StaticResource Zone}" Padding="14,12">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <Label Text="{x:Static h:Icons.Folder}" Style="{StaticResource Icon}" FontSize="18" TextColor="{StaticResource TexteSec}" />
                                <Label Grid.Column="1" Text="Vider les fichiers en cache" FontAttributes="Bold" VerticalOptions="Center" />
                                <Border Grid.Column="2" BackgroundColor="#14222E" Stroke="#244257" StrokeShape="RoundRectangle 12" Padding="10,4">
                                    <Label x:Name="TailleCache" Text="1.2 Mo libérables" FontSize="12" TextColor="{StaticResource Bleu}" />
                                </Border>
                            </Grid>
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnViderCache" /></Border.GestureRecognizers>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- ASSISTANCE & LÉGAL -->
                <Label Text="ASSISTANCE &amp; LÉGAL" Style="{StaticResource Rubrique}" Margin="4,8,0,0" />
                <Border Style="{StaticResource Card}" Padding="14">
                    <VerticalStackLayout Spacing="12">
                        <!-- lien 1 : retour à l'accueil, où se trouvent les numéros d'urgence -->
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border BackgroundColor="#3B1414" StrokeShape="Ellipse" Stroke="Transparent" WidthRequest="44" HeightRequest="44">
                                <Label Text="{x:Static h:Icons.Add}" Style="{StaticResource Icon}" TextColor="{StaticResource Erreur}" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="Urgences médicales Cameroun" FontAttributes="Bold" />
                                <Label Text="SAMU 119 • Urgences Police 117 • Pompiers 118" Style="{StaticResource Caption}" FontSize="11" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="{x:Static h:Icons.ChevronRight}" Style="{StaticResource Icon}" TextColor="{StaticResource TexteSec}" />
                            <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnUrgences" /></Grid.GestureRecognizers>
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource Bordure}" />
                        <!-- lien 2 : page d'informations légales -->
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border BackgroundColor="{StaticResource Surface}" StrokeShape="Ellipse" Stroke="Transparent" WidthRequest="44" HeightRequest="44">
                                <Label Text="{x:Static h:Icons.Check}" Style="{StaticResource Icon}" TextColor="{StaticResource TexteSec}" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="Ordre National des Pharmaciens (ONPC)" FontAttributes="Bold" />
                                <Label Text="Données conformes ANTIC &amp; RGPD santé" Style="{StaticResource Caption}" FontSize="11" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="{x:Static h:Icons.ChevronRight}" Style="{StaticResource Icon}" TextColor="{StaticResource TexteSec}" />
                            <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnLegal" /></Grid.GestureRecognizers>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- déconnexion -->
                <Border BackgroundColor="#2A1414" Stroke="#4A2020" StrokeShape="RoundRectangle 16" Padding="16" Margin="0,8,0,0">
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                        <Label Text="{x:Static h:Icons.Logout}" Style="{StaticResource Icon}" FontSize="18" TextColor="{StaticResource Erreur}" />
                        <Label Text="Se déconnecter de la session" FontAttributes="Bold" TextColor="{StaticResource Erreur}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnDeconnexion" /></Border.GestureRecognizers>
                </Border>

                <Label Text="PharmaGarde v2.4.0" Style="{StaticResource Caption}" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </ScrollView>
        <c:BarreNav Grid.Row="1" Actif="Profil" />
    </Grid>
</ContentPage>